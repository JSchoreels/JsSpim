{
  "name": "JsSpim – MIPS32 Simulator",
  "short_name": "JsSpim",
  "description": "JsSpim is an online MIPS32 simulator based on Prof. James Larus's Spim. It supports breakpoints, custom execution speed, ASCII memory view, highlight on changed registers/memory and radix display for memory.",
